// AutoDeco — auto-decoration for the Geometry Dash level editor (Geode 4.x)
#include <Geode/Geode.hpp>
#include <Geode/modify/EditorUI.hpp>
#include <random>
#include <set>
#include <map>
#include <algorithm>
#include <functional>

using namespace geode::prelude;

static constexpr int DECO_GROUP = 9999;

struct Style {
	const char* name;
	std::vector<int> surface;
	std::vector<int> side;
	std::vector<int> bg;
	int color;
	int density;
};

static const std::vector<Style>& styles() {
	static const std::vector<Style> s = {
		{"Modern",  {18, 19, 20}, {19, 20},     {1, 2, 3},  1005, 45},
		{"Glow",    {19, 20},     {18},         {2, 3},     1011, 40},
		{"Minimal", {18},         {},           {},         1010, 18},
		{"Tech",    {20, 19},     {18, 19},     {1, 3},     1006, 50},
		{"Space",   {18},         {19},         {2, 3, 1},  1011, 30},
		{"Nature",  {18, 19, 20}, {18, 19},     {20},       1,    65},
		{"Hell",    {20, 19},     {20},         {19, 18},   1005, 60},
		{"Fantasy", {19, 18, 20}, {19, 18},     {2, 3},     1006, 55},
		{"Neon",    {18, 20},     {20, 19},     {1, 2},     1005, 50},
	};
	return s;
}
static const char* STYLE_NAMES[10] = {"Modern","Glow","Minimal","Tech","Space","Nature","Hell","Fantasy","Neon","Random"};

static bool inDecoGroup(GameObject* o) { return o->belongsToGroup(DECO_GROUP); }

static int removeGenerated(LevelEditorLayer* lel) {
	std::vector<GameObject*> del;
	for (auto* o : CCArrayExt<GameObject*>(lel->m_objects))
		if (inDecoGroup(o)) del.push_back(o);
	for (auto* o : del) lel->removeObject(o, true);
	return (int)del.size();
}

static GameObject* place(LevelEditorLayer* lel, const Style& st, int id, CCPoint pos, std::mt19937& rng, bool back) {
	auto* o = lel->createObject(id, pos, false);
	if (!o) return nullptr;
	if (o->m_objectType != GameObjectType::Decoration) {
		lel->removeObject(o, true);
		return nullptr;
	}
	o->addToGroup(DECO_GROUP);
	if (o->m_baseColor) o->m_baseColor->m_colorID = st.color;
	o->m_zLayer = back ? ZLayer::B3 : ZLayer::B2;
	o->setRotation((float)(std::uniform_int_distribution<int>(0, 3)(rng) * 90));
	return o;
}

static int generate(LevelEditorLayer* lel, int styleIdx) {
	std::random_device rd; std::mt19937 rng(rd());
	auto chance = [&](int p) { return std::uniform_int_distribution<int>(0, 99)(rng) < p; };
	auto pick = [&](const std::vector<int>& v) { return v[std::uniform_int_distribution<size_t>(0, v.size() - 1)(rng)]; };

	removeGenerated(lel);

	std::set<std::pair<int,int>> cells;
	int minX = INT_MAX, maxX = INT_MIN, minY = INT_MAX, maxY = INT_MIN;
	for (auto* o : CCArrayExt<GameObject*>(lel->m_objects)) {
		auto p = o->getPosition();
		int cx = (int)std::floor(p.x / 30.f), cy = (int)std::floor(p.y / 30.f);
		minX = std::min(minX, cx); maxX = std::max(maxX, cx);
		minY = std::min(minY, cy); maxY = std::max(maxY, cy);
		if (o->m_objectType == GameObjectType::Solid) cells.insert({cx, cy});
	}
	if (minX == INT_MAX) return -1;

	int count = 0;
	auto& all = styles();
	auto styleFor = [&]() -> const Style& {
		return styleIdx >= 9 ? all[std::uniform_int_distribution<size_t>(0, all.size() - 1)(rng)] : all[styleIdx];
	};
	auto add = [&](const Style& st, const std::vector<int>& ids, CCPoint p, bool back) {
		if (ids.empty()) return;
		if (place(lel, st, pick(ids), p, rng, back)) ++count;
	};

	for (auto& [cx, cy] : cells) {
		const Style& st = styleFor();
		float x = cx * 30.f + 15.f, y = cy * 30.f + 15.f;
		if (!cells.count({cx, cy + 1}) && chance(st.density))
			add(st, st.surface, {x, y + 30.f}, false);
		if (!cells.count({cx - 1, cy}) && chance(st.density / 2))
			add(st, st.side, {x - 30.f, y}, true);
		if (!cells.count({cx + 1, cy}) && chance(st.density / 2))
			add(st, st.side, {x + 30.f, y}, true);
	}

	for (int cx = minX - 2; cx <= maxX + 2; cx += 3) {
		const Style& st = styleFor();
		if (st.bg.empty()) continue;
		int n = 1 + st.density / 40;
		for (int i = 0; i < n; ++i) {
			int cy = std::uniform_int_distribution<int>(std::max(0, minY - 2), maxY + 6)(rng);
			if (cells.count({cx, cy}) || !chance(st.density)) continue;
			add(st, st.bg, {cx * 30.f + 15.f, cy * 30.f + 15.f}, true);
		}
	}
	return count;
}

class AutoDecoPopup : public Popup<EditorUI*> {
protected:
	EditorUI* m_ui = nullptr;
	int m_style = 0;
	CCLabelBMFont* m_label = nullptr;
	CCLabelBMFont* m_status = nullptr;

	bool setup(EditorUI* ui) override {
		m_ui = ui;
		this->setTitle("AutoDeco");
		auto sz = m_mainLayer->getContentSize();

		m_label = CCLabelBMFont::create(STYLE_NAMES[0], "goldFont.fnt");
		m_label->setPosition({sz.width / 2, sz.height / 2 + 35});
		m_mainLayer->addChild(m_label);

		auto menu = CCMenu::create();
		menu->setPosition({0, 0});
		m_mainLayer->addChild(menu);

		auto l = CCSprite::createWithSpriteFrameName("navArrowBtn_001.png"); l->setFlipX(true);
		auto r = CCSprite::createWithSpriteFrameName("navArrowBtn_001.png");
		auto lb = CCMenuItemExt::createSpriteExtra(l, [this](auto) { step(-1); });
		auto rb = CCMenuItemExt::createSpriteExtra(r, [this](auto) { step(1); });
		lb->setPosition({sz.width / 2 - 90, sz.height / 2 + 35});
		rb->setPosition({sz.width / 2 + 90, sz.height / 2 + 35});
		menu->addChild(lb); menu->addChild(rb);

		auto gen = CCMenuItemExt::createSpriteExtra(ButtonSprite::create("Generate Deco"), [this](auto) {
			auto* lel = m_ui->m_editorLayer;
			int n = generate(lel, m_style);
			m_status->setString(n < 0 ? "Level is empty" : fmt::format("Added {} objects", n).c_str());
		});
		gen->setPosition({sz.width / 2, sz.height / 2 - 10});
		menu->addChild(gen);

		auto rem = CCMenuItemExt::createSpriteExtra(ButtonSprite::create("Remove Generated Deco", 200, true, "goldFont.fnt", "GJ_button_06.png", 30.f, 0.7f), [this](auto) {
			int n = removeGenerated(m_ui->m_editorLayer);
			m_status->setString(fmt::format("Removed {} objects", n).c_str());
		});
		rem->setPosition({sz.width / 2, sz.height / 2 - 55});
		menu->addChild(rem);

		m_status = CCLabelBMFont::create("", "chatFont.fnt");
		m_status->setPosition({sz.width / 2, 22});
		m_mainLayer->addChild(m_status);
		return true;
	}
	void step(int d) {
		m_style = (m_style + d + 10) % 10;
		m_label->setString(STYLE_NAMES[m_style]);
	}
public:
	static AutoDecoPopup* create(EditorUI* ui) {
		auto ret = new AutoDecoPopup();
		if (ret->initAnchored(320.f, 200.f, ui)) { ret->autorelease(); return ret; }
		delete ret; return nullptr;
	}
};

class $modify(AutoDecoUI, EditorUI) {
	bool init(LevelEditorLayer* lel) {
		if (!EditorUI::init(lel)) return false;
		auto menu = CCMenu::create();
		auto btn = CCMenuItemExt::createSpriteExtra(ButtonSprite::create("AutoDeco", 70, true, "bigFont.fnt", "GJ_button_04.png", 30.f, 0.5f),
			[this](auto) { AutoDecoPopup::create(this)->show(); });
		menu->addChild(btn);
		auto win = CCDirector::get()->getWinSize();
		menu->setPosition({50.f, win.height - 40.f});
		menu->setID("autodeco-menu"_spr);
		this->addChild(menu, 100);
		return true;
	}
};
